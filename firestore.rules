rules_version = '2';

// Regras de segurança do EscalaMed.
// Sem servidor próprio (plano gratuito), são estas regras que impedem um usuário
// de ler ou gravar o que não deve. Toda coleção não listada aqui fica bloqueada.
// Testes: tests/rules.test.mjs (rodam nos emuladores, veja o README).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Administrador da plataforma: uid listado em config/admins (campo "uids").
    // O documento só é editado pelo console do Firebase.
    function isPlatformAdmin() {
      let admins = /databases/$(database)/documents/config/admins;
      return signedIn() && exists(admins) && get(admins).data.get('uids', []).hasAny([request.auth.uid]);
    }

    // ----- Cargo da plataforma -----
    // O cargo é escolhido no perfil (users/{uid}.categoryId). Gestor, Coordenador de escala e
    // Administrativo só valem aprovados em access/{uid} (por administrador ou Gestor).
    // O administrador da plataforma vale como Gestor. Sem aprovação: acesso de Médico
    // (só os grupos em que a pessoa está).
    function accessPath(uid) {
      return /databases/$(database)/documents/access/$(uid);
    }

    // 'gestor' | 'coordenador' | 'administrativo' | 'none'
    function platformRole() {
      return isPlatformAdmin() ? 'gestor'
        : !exists(accessPath(me())) ? 'none'
        : get(accessPath(me())).data.approved != true ? 'none'
        : get(accessPath(me())).data.categoryId == 'gestor' ? 'gestor'
        : get(accessPath(me())).data.categoryId == 'coordenador-escala' ? 'coordenador'
        : get(accessPath(me())).data.categoryId == 'administrativo' ? 'administrativo'
        : 'none';
    }

    function isGestor() {
      return signedIn() && platformRole() == 'gestor';
    }

    function incoming() {
      return request.resource.data;
    }

    // Texto com tamanho entre min e max
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function optStr(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    // Só os campos listados mudaram
    function changedOnly(keys) {
      return incoming().diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Mesma lista de public/data/categories.js (cargos atuais e os que saíram da lista)
    function optCategory(v) {
      return v == null || v in ['gestor', 'coordenador-escala', 'academico', 'administrativo', 'assistente-social', 'auxiliar-enfermagem',
        'auxiliar-laboratorio', 'auxiliar-saude-bucal', 'biomedico', 'bioquimico', 'bombeiro',
        'condutor-socorrista', 'cuidador', 'dentista', 'educador-fisico', 'enfermeiro', 'farmaceutico',
        'fisioterapeuta', 'fonoaudiologo', 'instrumentador-cirurgico', 'maqueiro', 'medico',
        'medico-residente', 'nutricionista', 'psicologo', 'recepcionista', 'tarm', 'tecnico-enfermagem',
        'tecnico-laboratorio', 'tecnico-radiologia', 'terapeuta-ocupacional', 'veterinario', 'outro'];
    }

    // Registro no conselho: { type: "CRM", number: "28890", state: "CE" }
    function validCouncil(c) {
      return c == null || (c is map
        && c.keys().hasOnly(['type', 'number', 'state'])
        && c.keys().hasAll(['type', 'number', 'state'])
        && str(c.type, 2, 10)
        && c.number is string && c.number.matches('^[0-9A-Z./-]{1,20}$')
        && c.state is string && c.state.matches('^[A-Z]{2}$'));
    }

    // Foto: imagem pequena embutida (até ~45 KB) ou endereço https
    function validPhoto(v) {
      return v == null || (v is string && v.size() <= 60000
        && (v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$') || v.matches('^https://.+')));
    }

    // ---------- Usuários (perfil público) ----------
    // O documento nasce na etapa 3 do cadastro (signupStep 3) e fica completo na 4.
    match /users/{uid} {
      // Lista do perfil (certificações, formações...): até 20 itens. As regras não percorrem
      // listas, então o conteúdo de cada item é conferido no app.
      function optEntries(v) {
        return v == null || (v is list && v.size() <= 20);
      }

      // Configurações > Editar perfil: apelido, mini bio, Lattes e listas
      function validAbout(a) {
        return a == null || (a is map
          && a.keys().hasOnly(['nickname', 'bio', 'lattesUrl', 'certifications', 'education',
                               'experiences', 'academicLeagues', 'cooperatives'])
          && optStr(a.get('nickname', null), 40)
          && optStr(a.get('bio', null), 160)
          && (a.get('lattesUrl', null) == null
              || (a.lattesUrl is string && a.lattesUrl.size() <= 200 && a.lattesUrl.matches('^https?://[^ ]+$')))
          && optEntries(a.get('certifications', null))
          && optEntries(a.get('education', null))
          && optEntries(a.get('experiences', null))
          && optEntries(a.get('academicLeagues', null))
          && optEntries(a.get('cooperatives', null)));
      }

      function validUser(d) {
        return d.keys().hasOnly(['name', 'nameLower', 'photoURL', 'username', 'categoryId', 'specialty',
                                 'council', 'about', 'searchKeywords', 'signupStep', 'termsAcceptedAt',
                                 'termsVersion', 'createdAt', 'updatedAt'])
          && validAbout(d.get('about', null))
          && str(d.name, 2, 80)
          && str(d.nameLower, 2, 80)
          && validPhoto(d.photoURL)
          && optStr(d.username, 30)
          && optCategory(d.categoryId)
          && optStr(d.specialty, 80)
          && validCouncil(d.council)
          && d.signupStep in [3, 4]
          && str(d.termsVersion, 1, 20)
          && d.searchKeywords is list && d.searchKeywords.size() <= 60;
      }

      allow read: if signedIn();
      allow create: if isSelf(uid)
        && validUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().termsAcceptedAt == request.time;
      allow update: if isSelf(uid)
        && validUser(incoming())
        && incoming().createdAt == resource.data.createdAt
        && incoming().termsAcceptedAt == resource.data.termsAcceptedAt
        && incoming().termsVersion == resource.data.termsVersion
        && incoming().signupStep >= resource.data.signupStep
        && incoming().updatedAt == request.time;
      // O administrador apaga o perfil ao excluir o acesso de alguém (Configurações > Usuários)
      allow delete: if isSelf(uid) || isPlatformAdmin();

      // Dados pessoais: só o próprio usuário lê e grava
      match /private/{docId} {
        allow read: if isSelf(uid);
        allow delete: if isSelf(uid) || isPlatformAdmin();
        allow create, update: if isSelf(uid)
          && docId == 'data'
          && incoming().keys().hasOnly(['email', 'phone', 'cpf', 'state', 'updatedAt'])
          && optStr(incoming().get('email', null), 254)
          && (incoming().get('phone', null) == null || incoming().phone.matches('^[0-9]{10,11}$'))
          && (incoming().get('cpf', null) == null || incoming().cpf.matches('^[0-9]{11}$'))
          && (incoming().get('state', null) == null || incoming().state.matches('^[A-Z]{2}$'))
          && incoming().updatedAt == request.time;
      }
    }

    // ---------- Aprovação de cargos (Configurações > Usuários) ----------
    // access/{uid}: { categoryId, approved, decidedBy, decidedAt }. A decisão vale para o cargo
    // que a pessoa pediu naquele momento (categoryId tem de ser igual ao do perfil dela).
    // Qualquer logado lê (selo do cargo, quem pode ser coordenador). Só administrador ou Gestor
    // decidem; ninguém decide sobre si mesmo. A própria pessoa apaga ao trocar de cargo.
    match /access/{uid} {
      function validDecision(d) {
        return d.keys().hasOnly(['categoryId', 'approved', 'decidedBy', 'decidedAt'])
          && d.categoryId in ['gestor', 'coordenador-escala', 'administrativo']
          && d.categoryId == get(/databases/$(database)/documents/users/$(uid)).data.get('categoryId', null)
          && d.approved is bool
          && d.decidedBy == me()
          && d.decidedAt == request.time;
      }

      allow read: if signedIn();
      allow create, update: if isGestor() && uid != me() && validDecision(incoming());
      allow delete: if isSelf(uid) || (isGestor() && uid != me());
    }

    // ---------- Unidades de saúde ----------
    // Qualquer usuário logado pode cadastrar uma unidade que ainda não existe.
    match /healthUnits/{unitId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && incoming().keys().hasOnly(['name', 'nameLower', 'city', 'cityLower', 'state',
                                      'keywords', 'createdBy', 'createdAt'])
        && str(incoming().name, 3, 120)
        && str(incoming().nameLower, 3, 120)
        && incoming().keywords is list && incoming().keywords.size() <= 30
        && str(incoming().city, 2, 80)
        && str(incoming().cityLower, 2, 80)
        && incoming().state is string && incoming().state.matches('^[A-Z]{2}$')
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------- Grupos ----------
    // Equipe (type 'team'): memberIds (quem está na escala) e coordinatorIds (Coordenadores de
    // escala do grupo, sempre também membros; marcados pelo Gestor).
    //   Gestor: vê e altera todos os grupos de equipe.
    //   Coordenador de escala (aprovado) marcado no grupo: escala, convites e membros.
    //   Administrativo: vê todos os grupos de equipe, só o publicado.
    //   Membro: vê o grupo e o que está publicado.
    // Escala individual (type 'personal'): só o dono (memberIds == [dono]).
    match /groups/{groupId} {
      function groupPath() {
        return /databases/$(database)/documents/groups/$(groupId);
      }

      function groupData() {
        return get(groupPath()).data;
      }

      function groupAfter() {
        return getAfter(groupPath()).data;
      }

      function isMemberOf(g) {
        return signedIn() && me() in g.memberIds;
      }

      function isOwnerOf(g) {
        return signedIn() && g.type == 'personal' && me() == g.ownerId;
      }

      // Marcado no grupo e com o cargo de Coordenador de escala aprovado. Sem conferir o tipo:
      // escala individual nunca tem coordenadores (rolesValid), e assim a consulta
      // "grupos que eu coordeno" (coordinatorIds array-contains) passa nas regras.
      function isCoordinatorOf(g) {
        return signedIn() && me() in g.coordinatorIds && platformRole() == 'coordenador';
      }

      function isGestorOf(g) {
        return g.type == 'team' && isGestor();
      }

      // Altera a escala, convida e remove membros
      function editorOf(g) {
        return isGestorOf(g) || isCoordinatorOf(g) || isOwnerOf(g);
      }

      // Vê o grupo, os membros, os turnos e o que está publicado
      function canView(g) {
        return isMemberOf(g) || editorOf(g)
          || (g.type == 'team' && signedIn() && platformRole() == 'administrativo');
      }

      // Vê escalas em rascunho e o histórico delas (o Administrativo não)
      function seesDraftsOf(g) {
        return editorOf(g);
      }

      // Dados do grupo e turnos: Gestor e dono; o coordenador só enquanto o grupo é criado
      function settingsEditorOf(g) {
        return isGestorOf(g) || isOwnerOf(g) || (isCoordinatorOf(g) && g.setupStep != 'done');
      }

      function unique(list) {
        return list.toSet().size() == list.size();
      }

      function rolesValid(d) {
        return d.memberIds is list && d.coordinatorIds is list
          && d.memberIds.size() <= 300 && d.coordinatorIds.size() <= 50
          && unique(d.memberIds) && unique(d.coordinatorIds)
          && d.memberIds.hasAll(d.coordinatorIds)
          // Escala individual: só o dono, sem coordenadores
          && (d.type == 'team' || (d.memberIds == [d.ownerId] && d.coordinatorIds.size() == 0));
      }

      function validGroup(d) {
        return d.keys().hasOnly(['name', 'type', 'color', 'unit', 'categoryId', 'timezone',
                                 'ownerId', 'coordinatorIds', 'memberIds', 'setupStep', 'createdAt', 'updatedAt'])
          && str(d.name, 3, 60)
          && d.type in ['team', 'personal']
          && d.color is string && d.color.matches('^#[0-9A-Fa-f]{6}$')
          && (d.unit == null
              || (d.unit is map
                  && d.unit.keys().hasOnly(['id', 'name', 'city', 'state'])
                  && str(d.unit.id, 1, 128)
                  && str(d.unit.name, 3, 120)))
          && optStr(d.categoryId, 60)
          && str(d.timezone, 3, 60)
          && d.setupStep in ['shifts', 'members', 'done']
          && rolesValid(d);
      }

      function roleKeys() {
        return ['memberIds', 'coordinatorIds', 'updatedAt'];
      }

      // ----- Convite da própria pessoa: por e-mail (id = e-mail) ou por pessoa (id = uid) -----
      function invitePath() {
        return /databases/$(database)/documents/groups/$(groupId)/invites/$(myEmail());
      }

      function personInvitePath() {
        return /databases/$(database)/documents/groups/$(groupId)/invites/$(me());
      }

      function hasMyInvite() {
        return exists(personInvitePath()) || exists(invitePath());
      }

      function myInvite() {
        return exists(personInvitePath()) ? get(personInvitePath()).data : get(invitePath()).data;
      }

      function acceptsInvite(invite) {
        return invite.expiresAt > request.time
          && invite.get('status', 'pending') != 'declined'
          && incoming().memberIds.toSet() == resource.data.memberIds.toSet().union([me()].toSet())
          && incoming().coordinatorIds == resource.data.coordinatorIds;
      }

      allow read: if canView(resource.data);

      // Equipe: Gestor (entra como membro) ou Coordenador de escala (membro e coordenador).
      // Escala individual: qualquer pessoa, só para si.
      allow create: if signedIn()
        && validGroup(incoming())
        && incoming().ownerId == me()
        && incoming().memberIds == [me()]
        && (incoming().type == 'personal'
            || (isGestor() && incoming().coordinatorIds == [])
            || (platformRole() == 'coordenador' && incoming().coordinatorIds == [me()]))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Dados do grupo
      allow update: if settingsEditorOf(resource.data)
        && validGroup(incoming())
        && changedOnly(['name', 'color', 'unit', 'categoryId', 'timezone', 'setupStep', 'updatedAt'])
        && incoming().updatedAt == request.time;

      // Gestor: remove membros e marca/desmarca coordenadores (ninguém é adicionado por aqui:
      // a entrada é só por convite)
      allow update: if isGestorOf(resource.data)
        && validGroup(incoming())
        && changedOnly(roleKeys())
        && incoming().memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
        && incoming().updatedAt == request.time;

      // Coordenador: remove membros que não são coordenadores; não mexe nos coordenadores
      allow update: if isCoordinatorOf(resource.data)
        && validGroup(incoming())
        && changedOnly(roleKeys())
        && incoming().coordinatorIds == resource.data.coordinatorIds
        && incoming().memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
        && !resource.data.memberIds.toSet().difference(incoming().memberIds.toSet()).hasAny(resource.data.coordinatorIds)
        && incoming().updatedAt == request.time;

      // Aceitar convite: entra só a própria pessoa, como membro, e antes de vencer
      allow update: if signedIn()
        && resource.data.type == 'team'
        && !(me() in resource.data.memberIds)
        && hasMyInvite()
        && acceptsInvite(myInvite())
        && validGroup(incoming())
        && changedOnly(roleKeys())
        && incoming().updatedAt == request.time;

      // Sair do grupo: a pessoa tira só a si mesma (de membro e de coordenadora)
      allow update: if isMemberOf(resource.data)
        && resource.data.type == 'team'
        && changedOnly(roleKeys())
        && incoming().memberIds == resource.data.memberIds.removeAll([me()])
        && incoming().coordinatorIds == resource.data.coordinatorIds.removeAll([me()])
        && incoming().updatedAt == request.time;

      // Excluir: Gestor (equipe) ou o dono (escala individual)
      allow delete: if isGestorOf(resource.data) || isOwnerOf(resource.data);

      // ----- Membros (cartão: dados copiados do perfil) -----
      match /members/{memberId} {
        function validCard(d) {
          return d.keys().hasOnly(['name', 'email', 'photoURL', 'categoryId', 'specialty', 'council',
                                   'joinedAt', 'addedBy'])
            && str(d.name, 2, 80)
            && optStr(d.get('email', null), 254)
            && validPhoto(d.get('photoURL', null))
            && optCategory(d.get('categoryId', null))
            && optStr(d.get('specialty', null), 80)
            && validCouncil(d.get('council', null));
        }

        // E-mail do cartão (para a busca de membros): só o da própria conta
        function ownEmail(d) {
          return d.get('email', null) == null || d.email == request.auth.token.get('email', '').lower();
        }

        allow read: if canView(groupData());

        // Criação do grupo (mesmo lote): o dono entra como membro
        allow create: if isSelf(memberId) && signedIn()
          && !exists(groupPath())
          && getAfter(groupPath()).data.ownerId == memberId
          && validCard(incoming())
          && ownEmail(incoming())
          && incoming().joinedAt == request.time;

        // Aceitando convite (mesmo lote da entrada no grupo)
        allow create: if isSelf(memberId) && signedIn()
          && exists(groupPath())
          && !(memberId in groupData().memberIds)
          && memberId in groupAfter().memberIds
          && validCard(incoming())
          && ownEmail(incoming())
          && incoming().joinedAt == request.time;

        // A própria pessoa atualiza o cartão (nome, e-mail, foto, cargo)
        allow update: if isSelf(memberId)
          && isMemberOf(groupData())
          && changedOnly(['name', 'email', 'photoURL', 'categoryId', 'specialty', 'council'])
          && validCard(incoming())
          && ownEmail(incoming());

        // Remover membro, sair do grupo ou excluir o grupo: o cartão sai junto
        allow delete: if signedIn()
          && (isSelf(memberId) || editorOf(groupData()))
          && (!existsAfter(groupPath()) || !(memberId in groupAfter().memberIds));
      }

      // ----- Convites -----
      // Dois tipos, pelo id do documento:
      //   - por e-mail: id = e-mail convidado, em minúsculas;
      //   - por pessoa (escolhida na busca da plataforma): id = uid. O e-mail da
      //     pessoa continua privado: quem convida não fica sabendo.
      // O convite guarda nome do grupo e da unidade porque quem é convidado
      // ainda não pode ler o grupo.
      match /invites/{key} {
        function inviteCommon(d) {
          return str(d.groupName, 3, 60)
            && optStr(d.unitName, 120)
            && d.invitedBy == me()
            && str(d.invitedByName, 1, 80)
            && d.createdAt == request.time
            && d.expiresAt is timestamp
            && d.expiresAt > request.time
            && d.expiresAt <= request.time + duration.value(31, 'd');
        }

        function emailInvite(d) {
          return d.keys().hasOnly(['email', 'groupName', 'unitName', 'invitedBy',
                                   'invitedByName', 'createdAt', 'expiresAt'])
            && d.email == key
            && key == key.lower()
            && key.size() <= 254
            && key.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
        }

        function personInvite(d) {
          return d.keys().hasOnly(['uid', 'name', 'groupName', 'unitName', 'invitedBy',
                                   'invitedByName', 'createdAt', 'expiresAt'])
            && d.uid == key
            && str(d.name, 2, 80)
            && exists(/databases/$(database)/documents/users/$(key))
            && !(key in groupData().memberIds);
        }

        function isMine() {
          return key == me() || key == myEmail();
        }

        allow read: if signedIn() && (isMine() || editorOf(groupData()));
        allow create, update: if editorOf(groupData())
          && groupData().type == 'team'
          && (emailInvite(incoming()) || personInvite(incoming()))
          && inviteCommon(incoming());
        allow delete: if signedIn() && (isMine() || editorOf(groupData()));

        // Recusar: a própria pessoa marca o convite como recusado (em vez de apagar), para
        // quem convidou ficar sabendo. Só esses três campos mudam; o resto fica igual.
        allow update: if signedIn() && isMine()
          && resource.data.get('status', 'pending') != 'declined'
          && changedOnly(['status', 'respondedAt', 'respondedByName'])
          && incoming().status == 'declined'
          && incoming().respondedAt == request.time
          && str(incoming().respondedByName, 1, 80);
      }

      // ----- Turnos -----
      // startMinute e endMinute: minutos desde 00:00 (0 a 1439).
      // Fim menor que o início = termina no dia seguinte; iguais = 24 horas.
      match /shifts/{shiftId} {
        function validShift(d) {
          return d.keys().hasOnly(['title', 'startMinute', 'endMinute', 'createdAt', 'updatedAt'])
            && str(d.title, 1, 40)
            && d.startMinute is int && d.startMinute >= 0 && d.startMinute <= 1439
            && d.endMinute is int && d.endMinute >= 0 && d.endMinute <= 1439
            && d.updatedAt == request.time;
        }

        allow read: if canView(groupData());
        allow create: if settingsEditorOf(groupData())
          && validShift(incoming())
          && incoming().createdAt == request.time;
        allow update: if settingsEditorOf(groupData())
          && validShift(incoming())
          && incoming().createdAt == resource.data.createdAt;
        allow delete: if settingsEditorOf(groupData());
      }

      // ----- Histórico de movimentações (log imutável: sem update; delete só junto com o grupo) -----
      // public == false: ação numa escala em rascunho; só quem vê rascunho (Gestor, coordenador
      // do grupo, dono) vê (os outros consultam com where("public", "==", true)).
      // Trocas, cessões e assumir plantão vago podem ser gravadas por qualquer membro;
      // as ações do editor, só por quem altera a escala.
      match /movements/{movementId} {
        function memberTypes() {
          return ['swap', 'cession', 'vacant_taken'];
        }

        function editorTypes() {
          return ['vacant_open', 'vacant_closed', 'assigned', 'unassigned', 'published', 'unpublished', 'replicated'];
        }

        function optMonth(v) {
          return v == null || (v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'));
        }

        function optDate(v) {
          return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
        }

        function optClock(v) {
          return v == null || (v is string && v.matches('^[0-2][0-9]:[0-5][0-9]$'));
        }

        function validMovement(d) {
          return d.keys().hasOnly(['type', 'groupId', 'actorUid', 'targetUid', 'memberUids', 'public',
                                   'shiftId', 'shiftTitle', 'shiftDate', 'shiftStart', 'shiftEnd',
                                   'counterShiftId', 'counterShiftDate', 'counterShiftStart', 'counterShiftEnd',
                                   'count', 'scheduleMonth', 'fromMonth', 'monthKey', 'createdAt'])
            && d.type in memberTypes().concat(editorTypes())
            && d.groupId == groupId
            && d.actorUid == me()
            && optStr(d.get('targetUid', null), 128)
            && d.memberUids is list && d.memberUids.size() >= 1 && d.memberUids.size() <= 2
            && me() in d.memberUids
            && d.public is bool
            && optStr(d.get('shiftId', null), 128)
            && optStr(d.get('shiftTitle', null), 40)
            && optDate(d.get('shiftDate', null))
            && optClock(d.get('shiftStart', null))
            && optClock(d.get('shiftEnd', null))
            && optStr(d.get('counterShiftId', null), 128)
            && optDate(d.get('counterShiftDate', null))
            && optClock(d.get('counterShiftStart', null))
            && optClock(d.get('counterShiftEnd', null))
            && (d.get('count', null) == null || (d.count is int && d.count >= 0 && d.count <= 20))
            && optMonth(d.get('scheduleMonth', null))
            && optMonth(d.get('fromMonth', null))
            && d.monthKey is string && d.monthKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && d.createdAt == request.time;
        }

        allow read: if canView(groupData())
          && (resource.data.public == true || seesDraftsOf(groupData()));
        allow create: if validMovement(incoming())
          && ((isMemberOf(groupData()) && incoming().type in memberTypes()) || editorOf(groupData()));
        allow update: if false;
        // Excluir o grupo (no mesmo lote) leva o histórico junto
        allow delete: if (isGestorOf(groupData()) || isOwnerOf(groupData())) && !existsAfter(groupPath());
      }

      // ----- Escala mensal (id = "YYYY-MM") -----
      // assignments: { "07_<turno>": [uid] } (escala dinâmica); vacancies: { "07_<turno>": n };
      // fixed: cópia de assignments ao publicar (escala fixa); shifts: turnos congelados ao publicar.
      // Alocar e desalocar usam arrayUnion/arrayRemove no campo da célula.
      match /schedules/{month} {
        function validSchedule(d) {
          return d.keys().hasOnly(['status', 'assignments', 'vacancies', 'fixed', 'shifts',
                                   'publishedAt', 'publishedBy', 'createdAt', 'updatedAt', 'updatedBy'])
            && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && d.status in ['draft', 'published']
            && d.assignments is map && d.assignments.size() <= 1500
            && d.vacancies is map && d.vacancies.size() <= 1500
            && d.get('fixed', {}) is map && d.get('fixed', {}).size() <= 1500
            && d.get('shifts', {}) is map && d.get('shifts', {}).size() <= 50
            && d.updatedBy == me()
            && d.updatedAt == request.time;
        }

        // Rascunho: só Gestor, coordenador do grupo e dono veem
        allow read: if canView(groupData())
          && (resource == null || resource.data.status == 'published' || seesDraftsOf(groupData()));
        allow create: if editorOf(groupData())
          && validSchedule(incoming())
          && incoming().createdAt == request.time;
        allow update: if editorOf(groupData())
          && validSchedule(incoming())
          && incoming().createdAt == resource.data.createdAt;
        allow delete: if isGestorOf(groupData()) || isOwnerOf(groupData());
      }
    }

    // Administradores da plataforma: qualquer usuário logado lê (o app decide se mostra
    // a aba Usuários); ninguém grava pelo app.
    match /config/admins {
      allow read: if signedIn();
    }

    // "Meus convites": busca em todos os grupos pelos convites do próprio e-mail
    // e quem convidou acompanha os convites que mandou (ex.: saber que foi recusado)
    match /{path=**}/invites/{key} {
      allow read: if signedIn()
        && (resource.data.get('uid', null) == me() || resource.data.get('email', null) == myEmail()
            || resource.data.get('invitedBy', null) == me());
    }
  }
}
